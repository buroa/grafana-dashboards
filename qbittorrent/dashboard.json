          },
          "editorMode": "code",
          "expr": "sum(sum_over_time((max by (instance_name) (clamp_min(qbittorrent_session_upload_bytes{instance_name=~\"$instance_name\"} - qbittorrent_session_upload_bytes{instance_name=~\"$instance_name\"} offset 1m, 0)))[1d:1m] offset -1d))",
          "legendFormat": "Uploaded",
          "range": true,
