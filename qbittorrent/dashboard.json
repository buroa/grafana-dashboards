          },
          "editorMode": "code",
          "expr": "sum(sum_over_time((max by (instance_name) (clamp_min(qbittorrent_session_download_bytes{instance_name=~\"$instance_name\"} - qbittorrent_session_download_bytes{instance_name=~\"$instance_name\"} offset 1m, 0)))[1d:1m] offset -1d))",
